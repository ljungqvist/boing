{
  "expo": {
    "name": "Boing",
    "slug": "boing",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "boing",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0e10",
    "ios": {
      "bundleIdentifier": "info.ljungqvist.boing",
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSCameraUsageDescription": "Boing films your jump to measure its height.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ]
      },
      "requireFullScreen": true
    },
    "android": {
      "package": "info.ljungqvist.boing",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.WRITE_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0e0e10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Nitro / JNI look these up by name from C++ (fbjni) and by reflection.\n-keep class com.margelo.nitro.** { *; }\n-keep class com.mrousavy.camera.** { *; }\n-keep class expo.modules.boingupload.** { *; }\n-keep class com.google.mediapipe.** { *; }\n-keep class com.google.protobuf.** { *; }\n-dontwarn com.google.mediapipe.proto.**\n# MediaPipe image embedder (unused) refers to LiteRT-LM, which is not bundled.\n-dontwarn com.google.ai.edge.litertlm.**\n"
          }
        }
      ],
      "./plugins/withLanCleartext",
      "./plugins/withSensorPortrait"
    ]
  }
}
